# systemd unit for the xsphere AI control service (MCP + REST for Claude, port 8089).
#
# The only way a Claude session acts on the experiment.  It writes nothing
# unless Lucas arms a group on the Control page (http://xbox-pi:8088/control),
# and only within the rails set there.  Arms are never saved: every start of
# this unit begins with everything disarmed.
#
# Install:
#   sudo cp aicontrol/xsphere-aicontrol.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xsphere-aicontrol
#
# Then browse to  http://<pi>:8089/   (read-only status page)
# Logs:  journalctl -u xsphere-aicontrol -f
#
# The broker runs in Docker (IOTstack), hence After=docker.service; the
# service connects asynchronously and keeps retrying, so a broker that is
# still starting does not stop it.  The InfluxDB token for query_history is
# read from the repo's .env (INFLUX_TOKEN) unless XSPHERE_AICONTROL_INFLUX_TOKEN
# is set here; only its source is logged, never the value.

[Unit]
Description=xsphere AI control service (MCP for Claude)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=xbox
WorkingDirectory=/home/xbox/xsphere-slow-control
ExecStart=/home/xbox/miniconda3/envs/slowcontrol/bin/python -u -m aicontrol
Environment=PYTHONUNBUFFERED=1
Environment=XSPHERE_AICONTROL_INSTANCE=production
Environment=XSPHERE_MQTT_HOST=localhost
Environment=XSPHERE_MQTT_PORT=1883
Environment=XSPHERE_AICONTROL_PORT=8089
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
