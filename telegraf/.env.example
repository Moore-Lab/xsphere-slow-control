# Telegraf connection values
# Copy to .env and fill in before the first deploy.
#
# IOTstack (what xbox-pi runs): the telegraf container is NOT given these as
# environment variables.  `bash telegraf/deploy-iotstack.sh --env --apply`
# writes them as literals into ~/IOTstack/volumes/telegraf/telegraf.conf.
# Addresses are as seen from inside the Docker network: container name and
# container port, not localhost / the host port.
#
# Native apt telegraf: load this file as a systemd EnvironmentFile and use
# host addresses instead (see SETUP.md 4f).

# InfluxDB 2.x connection (xbox-pi: container influxdb2, org xbox-server)
INFLUX_URL=http://influxdb2:8086
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=xbox-server
INFLUX_BUCKET=xsphere

# MQTT broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
