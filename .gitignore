# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Local environment / secrets
.env
telegraf/.env

# Runtime state of the TrackerController + SequencerController (auto-managed,
# do not commit — these reflect operator choices, not project config).
slowcontrol/trackers.json
slowcontrol/trackers.json.tmp
slowcontrol/sequencer.json
slowcontrol/sequencer.json.tmp
slowcontrol/pv_interlock.json
slowcontrol/pv_interlock.json.tmp
slowcontrol/nge_state.json
slowcontrol/nge_state.json.tmp
slowcontrol/turbovac_state.json
slowcontrol/turbovac_state.json.tmp
# Heater PIDs an automatic windup rescue put in Manual and has not yet seen
# back in Auto (PlcDriver; removed when empty).
slowcontrol/pid_rescue.json
slowcontrol/pid_rescue.json.tmp

# Runtime state of the AI control service: the human rails (set on the Control
# page), its audit log, and the LN2 open timers.  Operator decisions and
# history, not project config.
aicontrol/rails.json*
aicontrol/audit.jsonl*
aicontrol/runtime.json*
# A test instance's own state (python -m aicontrol without the unit's environment).
aicontrol/test-state/

# Editor / OS
*.swp
.DS_Store
