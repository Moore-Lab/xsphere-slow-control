  {
    "id": "fn-flow-display",
    "type": "function",
    "z": "xsphere-tab",
    "name": "Format flow",
    "func": "var p = msg.payload;\nvar sccm = parseFloat(p.value_sccm);\nvar pct  = parseFloat(p.percent_fs);\nvar text;\n\nif (p.over_range) {\n    // The MFC parks its output near +7 V for 1-2 min after power-up while\n    // the sensor heaters settle. Do not show that as a flow rate.\n    text = 'WARMING UP / OVER RANGE (' + parseFloat(p.value_v).toFixed(2) + ' V) - reading not valid';\n} else {\n    text = isNaN(sccm) ? '?' : sccm.toFixed(2) + ' sccm';\n    if (!isNaN(pct)) text += '  (' + pct.toFixed(1) + '% FS)';\n    if (p.gcf && p.gcf !== 1) text += '  [GCF ' + p.gcf + ' from ' + p.cal_gas + ']';\n}\n\n// Gauge needs a bare number, clamped to its 0-100 range\nvar gauge = isNaN(pct) ? 0 : Math.max(0, Math.min(100, pct));\n\nreturn [{payload: text}, {payload: gauge}];",
    "outputs": 2,
    "x": 300,
    "y": 1640,
    "wires": [["ui-text-flow"], ["ui-gauge-flow"]]
  },

