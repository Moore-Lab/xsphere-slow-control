  {
    "id": "fn-path-conflict",
    "type": "function",
    "z": "xsphere-tab",
    "name": "Format conflict alert",
    "func": "// An empty retained payload is how the controller clears an alert.\nvar p = msg.payload;\nif (!p || p === '' || (typeof p === 'object' && !p.msg)) {\n    msg.payload = '';\n    return msg;\n}\nvar text = (typeof p === 'object') ? p.msg : String(p);\nmsg.payload = '\\u26a0 ' + text;\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 2280,
    "wires": [["ui-text-path-conflict"]]
  },

