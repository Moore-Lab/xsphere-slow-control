  {
    "id": "fn-bypass-feedback",
    "type": "function",
    "z": "xsphere-tab",
    "name": "Bypass switch feedback",
    "func": "// Drive the toggle from the valve state the PLC actually reports, so\n// the switch cannot sit in a position the hardware is not in.\nvar p = msg.payload;\nif (!p || p.state === undefined || p.state === null) { return null; }\nreturn {payload: (p.state ? {state: 1} : {state: 0})};",
    "outputs": 1,
    "x": 350,
    "y": 2330,
    "wires": [["ui-switch-bypass"]]
  },

