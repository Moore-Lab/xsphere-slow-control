  {
    "id": "fn-gasflow-status",
    "type": "function",
    "z": "xsphere-tab",
    "name": "Format gas path",
    "func": "var p = msg.payload;\nvar path = p.path || 'unknown';\nvar label = {\n    mks:      'MKS  (metered flow through the controller)',\n    bypass:   'BYPASS  (unmetered return flow)',\n    isolated: 'ISOLATED  (both legs shut)',\n    conflict: 'CONFLICT  -  both legs open!',\n    unknown:  'UNKNOWN  (waiting for PLC feedback)'\n}[path] || path;\n\nvar txt = 'Path: ' + label;\ntxt += '   |   MKS valve: ' + String(p.mks_mode || '?').toUpperCase();\ntxt += '   |   Bypass: ' + (p.bypass_open === null || p.bypass_open === undefined ? '?' : (p.bypass_open ? 'OPEN' : 'CLOSED'));\n\nmsg.payload = txt;\nmsg.style = (path === 'conflict') ? {color: 'red', 'font-weight': 'bold'} : {};\nreturn msg;",
    "outputs": 1,
    "x": 330,
    "y": 2030,
    "wires": [["ui-text-gasflow"]]
  },

