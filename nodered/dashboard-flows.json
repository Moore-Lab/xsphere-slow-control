    "wires": [["fn-level-display"]]
  },

  {
    "id": "fn-level-display",
    "type": "function",
    "z": "xsphere-tab",
    "name": "Format level",
    "func": "var vessel = msg.topic.split('/').pop();\nvar p = msg.payload;\n// The PLC driver publishes {raw, filtered}; the ESP32 boards publish {raw_pf}.\n// Accept all three so the widget works whichever publisher is feeding it.\nvar n = [p.filtered, p.raw, p.raw_pf].filter(function (v) { return v !== undefined && v !== null; })[0];\nvar val = n !== undefined ? parseFloat(n).toFixed(3) + ' pF' : '?';\nif (p.valid === false) val = 'FAULT';\nmsg.payload = vessel.toUpperCase() + ': ' + val;\nreturn msg;",
    "outputs": 1,
    "x": 300,
    "y": 680,
    "wires": [["ui-text-level"]]
  },

