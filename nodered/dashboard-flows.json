  {
    "id": "mqtt-in-coast-status",
    "type": "mqtt in",
    "z": "xsphere-tab",
    "name": "Coast Status",
    "topic": "xsphere/status/coast/cryostat",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 100,
    "y": 1240,
    "wires": [["fn-coast-status"]]
  },

  {
    "id": "fn-coast-status",
    "type": "function",
    "z": "xsphere-tab",
    "name": "Format coast state",
    "func": "var p = msg.payload;\nvar state = p.state || 'unknown';\nvar base = state.split(':')[0];\nvar label = {\n    disarmed:    'DISARMED  (plain level autofill)',\n    latched_off: 'LATCHED OFF  (backstop fired — waiting for a proven refill)',\n    released:    'RELEASED  (data unusable — filling on level alone)',\n    monitoring:  'MONITORING  (waiting for the vessel to empty)',\n    coasting:    'COASTING  (refill held off)',\n    converged:   'CONVERGED  (refilling now)',\n    backstop:    'BACKSTOP  (refill forced)'\n}[base] || state;\n\nfunction num(v, d) { return (v === null || v === undefined) ? '?' : parseFloat(v).toFixed(d); }\n\nvar txt = 'Coast: ' + label;\ntxt += '   |   ΔT: ' + num(p.delta_k, 1) + ' K (max ' + num(p.delta_max_k, 1) + ')';\ntxt += '   |   level ' + num(p.level, 3) + ' / ' + num(p.empty_threshold, 3);\nif (p.elapsed_s !== null && p.elapsed_s !== undefined) {\n    txt += '   |   ' + Math.round(p.elapsed_s / 60) + ' of ' + Math.round(p.max_duration_s / 60) + ' min';\n}\nif (p.hold_reason) { txt += '   |   ' + p.hold_reason; }\nif (p.release_reason) { txt += '   |   ' + p.release_reason; }\nif (p.armed && p.ladder_rung_entered === false) {\n    txt += '   |   LADDER RUNG NOT ENTERED — the PLC will refill early';\n}\n\nmsg.payload = txt;\nif (base === 'latched_off' || base === 'backstop' || base === 'released') {\n    msg.style = {color: 'red', 'font-weight': 'bold'};\n} else if (base === 'coasting' || base === 'monitoring') {\n    msg.style = {color: '#b8860b', 'font-weight': 'bold'};\n} else {\n    msg.style = {};\n}\nreturn msg;",
    "outputs": 1,
    "x": 330,
    "y": 1240,
    "wires": [["ui-text-coast-status"]]
  },

