  {
    "id": "fn-mks-valve-status",
    "type": "function",
    "z": "xsphere-tab",
    "name": "Format MKS valve",
    "func": "var p = msg.payload;\nvar mode = (p.mode || 'unknown').toUpperCase();\nvar txt = 'Valve: ' + mode;\nif (p.desired && p.desired !== p.mode) {\n    txt += '  (commanded ' + String(p.desired).toUpperCase() + ')';\n}\nif (p.setpoint_sccm !== undefined && p.setpoint_sccm !== null) {\n    txt += '   |   SP: ' + parseFloat(p.setpoint_sccm).toFixed(2) + ' sccm';\n}\nif (p.setpoint_v !== undefined && p.setpoint_v !== null) {\n    txt += ' (' + parseFloat(p.setpoint_v).toFixed(3) + ' V)';\n}\nmsg.payload = txt;\nreturn msg;",
